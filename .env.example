# Copy to .env and fill in for local runs. These same names are injected by
# databricks.yml bundle variables when running in CI/CD.

CATALOG_NAME=dev_catalog
SCHEMA_NAME=gold
EXPERIMENT_ID=1234567890
FOUNDATION_MODEL_NAME=databricks-meta-llama-3-1-70b-instruct
ENDPOINT_NAME=sql-workflow-agent-dev
REGISTERED_MODEL_NAME=sql_workflow_agent
MODEL_ALIAS=champion
SQL_CONTEXT_TABLES=sales,customers
SQL_ALLOWED_TABLES=gold.sales,gold.customers

# Needed only for tools.py SQL execution / integration tests
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_SQL_HOST=
DATABRICKS_SQL_HTTP_PATH=
